# 复制成 .env 后填写。.env 不进版本库。
JOURNAL_DB_PATH=/var/lib/journal/journal.db
JOURNAL_MEDIA_DIR=/var/lib/journal/media
JOURNAL_APP_TOKEN=请换成一个口令
JOURNAL_DAY_BOUNDARY_HOUR=4

# 模型。OpenAI 兼容接口即可。
JOURNAL_LLM_BASE_URL=https://api.deepseek.com
JOURNAL_LLM_API_KEY=

# 默认两个都用 deepseek-flash。
#
#   deepseek-flash    100 万上下文，能看图
#   deepseek-v4-pro   100 万上下文，不能看图（纯文本）
#
# 为什么默认都用 flash：拍照是这个产品的一部分，图片要真的发给模型才有意义。
# 「问它」会把当天照片一起送过去，换成 pro 就没有这个能力了。
# 如果你更看重推理深度、愿意放弃看图，把下面这行改成 deepseek-v4-pro。
JOURNAL_MODEL=deepseek-flash
JOURNAL_MODEL_DEEP=deepseek-flash
