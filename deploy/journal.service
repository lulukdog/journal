[Unit]
Description=journal web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/journal
EnvironmentFile=/opt/journal/.env
ExecStart=/opt/journal/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 10002 --log-level warning --no-access-log
Restart=always
RestartSec=3
User=journal
Group=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=append:/var/log/journal-app.log
StandardError=append:/var/log/journal-app.log

[Install]
WantedBy=multi-user.target
